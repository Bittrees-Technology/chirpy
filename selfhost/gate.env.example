# Self-hosted Chirpy gate environment. Copy to gate.env (the installer writes this for you).

# Public domain the gate is served at (used for your reverse proxy / TLS).
GATE_DOMAIN=gate.example.org

# Compose host port behind your reverse proxy (container port stays 8788).
# For a direct Node deployment, GATE_PORT is the process listen port instead.
GATE_PORT=8788
# Compose host publication and direct Node listeners bind loopback by default. Keep this for a
# host reverse proxy/tunnel. A different interface requires deliberate routing
# and firewall review; never expose the unencrypted port directly to the Internet.
GATE_BIND_HOST=127.0.0.1

# CORS allow-origin: the exact origin of your Chirpy web app (the browser that POSTs joins).
# Use the real origin in production rather than "*".
GATE_ALLOW_ORIGIN=https://chirpy.example.org

# The gatekeeper bot's EOA private key (0x-hex). This wallet must be added as a super-admin
# of every gated room it manages. Generate one with:
#   node selfhost/gen-gatekeeper-key.mjs
XMTP_GATEKEEPER_PRIVATE_KEY=

# Unrestricted mainnet RPC for on-chain gate reads (token / Safe / ENS). Do NOT use a
# domain-allowlisted browser key here — a server has no browser origin.
MAINNET_RPC_URL=

# Directory for the persistent XMTP MLS store. Set in the container image (default /data, backed
# by a mounted volume — see docker-compose.yml / fly.toml). Only override for a custom mount path.
GATE_DATA_DIR=/data

# Optional per-process fixed-window request limit for /api/room-join.
# Defaults to 60 requests per 60,000 ms per client address.
CHIRPY_RATE_LIMIT_MAX=60
CHIRPY_RATE_LIMIT_WINDOW_MS=60000

# Required for v2 scoped authorizations and trusted published rooms.
GATE_PUBLIC_URL=https://gate.example.org/api/room-join
CHIRPY_GATE_ROOMS_FILE=/config/rooms.json

# Required separate 32-byte hex key for the encrypted XMTP database. Keep a secure backup.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same key across restarts/restores. Do not replace it on an existing database.
GATE_DB_ENCRYPTION_KEY=

# Production by default. Use dev only for isolated acceptance tests.
GATE_XMTP_ENV=production

# Optional membership maintenance: off (default), audit, or enforce.
# Start with audit and review logs before enabling enforce. Protects administrators;
# confirmed nonholders require two observations at least five minutes apart.
GATE_MEMBERSHIP_MODE=off

# Optional: enable only when supporting native apps with the same signed admission rules.
# GATE_NATIVE_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
