# Keep disabled until the authenticated source and dispatch worker pass acceptance.
CHAT_MAIL_INBOUND_ENABLED=0
# Separate random 32-byte lowercase hex source HMAC and payload encryption keys.
CHAT_MAIL_INBOUND_SOURCE_SECRET=
CHAT_MAIL_INBOUND_DATA_KEY=
# Exact Wallet HTTPS /api/service/inbound endpoint and independent chirpy-inbound key.
CHAT_MAIL_INBOUND_IDENTITY_URL=
CHAT_MAIL_INBOUND_IDENTITY_SECRET=
# Explicit pilot mailbox allowlist; canonical addresses, maximum 20.
CHAT_MAIL_INBOUND_MAILBOXES=
KV_REST_API_URL=
KV_REST_API_TOKEN=
