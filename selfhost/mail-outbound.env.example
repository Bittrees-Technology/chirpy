# Private Acer worker only. Also supply protected mail.env settings, selecting smtp.
# Keep both admission and this supervisor disabled until acceptance is complete.
CHAT_MAIL_OUTBOUND_WORKER_ENABLED=0
CHAT_SMTP_HOST=127.0.0.1
CHAT_SMTP_PORT=25
CHAT_SMTP_TLS_SERVERNAME=acer-server
CHAT_SMTP_TLS_CA_FILE=/etc/ssl/certs/ssl-cert-snakeoil.pem
# Optional paired relay authentication; never reuse a member's mailbox password.
CHAT_SMTP_USER=
CHAT_SMTP_PASSWORD=
# Separate explicitly provisioned private local SQLite journal and random key.
CHAT_SMTP_JOURNAL_FILE=/var/lib/chat-mail-outbound/journal.sqlite
CHAT_SMTP_JOURNAL_KEY=
CHAT_SMTP_JOURNAL_ID=
# Compute --profile after provisioning. Same opaque value goes to Vercel/Acer.
CHAT_SMTP_PROFILE=
