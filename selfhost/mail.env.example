# Disabled until verification, provider/domain and operational acceptance are complete.
CHIRPY_MAIL_ENABLED=0
CHIRPY_MAIL_SERVICE_URL=https://chirpy.bittrees.org/api/mail
CHIRPY_MAIL_FROM=
# Comma-separated approved EOA sending wallets. Never private keys.
CHIRPY_MAIL_SENDERS=
# Separate 32-byte lowercase hex encryption key, kept in the secret manager.
CHIRPY_MAIL_DATA_KEY=
# Independent secret, at least 32 characters, used only by the scheduler.
CHIRPY_MAIL_WORKER_SECRET=
# Only resend is implemented here; unsupported values fail closed.
CHIRPY_MAIL_PROVIDER=resend
# Queued jobs are pinned to the original credential/sender/service.
# Review pending jobs before rotating this key; never auto-rebind them.
RESEND_API_KEY=
# Existing durable Redis REST service, or a dedicated instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional exact native/staging origins. Preview deployments always stay disabled.
CHIRPY_MAIL_ALLOWED_ORIGINS=

# Independently enabled signed provider events, including while sending is paused.
CHIRPY_MAIL_WEBHOOK_ENABLED=0
RESEND_WEBHOOK_SECRET=

# Optional Wallet-backed mode; both are required together. Missing/invalid paired
# configuration disables the pilot. Imported mappings still require live consent.
CHIRPY_MAIL_IDENTITY_URL=
CHIRPY_MAIL_IDENTITY_SECRET=
