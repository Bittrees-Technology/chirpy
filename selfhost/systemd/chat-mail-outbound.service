[Unit]
Description=Chat private outbound mail worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chat-mail-outbound
Group=chat-mail-outbound
WorkingDirectory=/opt/chat-mail-outbound/release
EnvironmentFile=/etc/chat-mail-outbound/worker.env
ExecStart=/opt/chat-mail-outbound/runtime/bin/node selfhost/mail-outbound-worker.mjs --once
TimeoutStartSec=90
TimeoutStopSec=10
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
StateDirectory=chat-mail-outbound
StateDirectoryMode=0700
ReadWritePaths=/var/lib/chat-mail-outbound
MemoryMax=768M
TasksMax=128
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chat-mail-outbound
