[Unit]
Description=Chat Resend API scheduler (install disabled)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chat-mail-api-scheduler
Group=chat-mail-api-scheduler
WorkingDirectory=/opt/chat-mail-api-scheduler
EnvironmentFile=/etc/chat-mail-api-scheduler/worker.env
ExecStart=/opt/chat-mail-api-scheduler/runtime/bin/node selfhost/mail-api-scheduler.mjs --once
# A tick and its read-only health check each have a sixty-second network budget.
TimeoutStartSec=135
TimeoutStopSec=10
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=192M
TasksMax=32
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chat-mail-api-scheduler
