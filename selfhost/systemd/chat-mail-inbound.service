[Unit]
Description=Chat inbound mail worker (one job)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/chat/app
EnvironmentFile=%h/.config/chat/mail-inbound.env
ExecStart=%h/.local/share/chat/runtime/bin/node %h/.local/share/chat/app/selfhost/mail-inbound-worker.mjs --once
TimeoutStartSec=110
TimeoutStopSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/chat-mail-bridge
# The configured sender directory must match this protected writable path.
# Install/run only after source, identity, recovery and live acceptance checks.
