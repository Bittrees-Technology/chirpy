{
  "name": "chat-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/web build",
    "preview": "pnpm --filter @app/web preview",
    "rollout:proof": "node scripts/rollout-proof.mjs",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert @xmtp",
    "e2e:xmtp": "XMTP_E2E=1 VITE_TRANSPORT=xmtp VITE_XMTP_ENV=dev playwright test --grep @xmtp",
    "tauri": "pnpm --filter @app/web tauri",
    "test:hardening": "vitest run --project api"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "jsdom": "29.1.1",
    "typescript": "^5.6.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "axios@>=1.0.0 <1.18.0": "1.18.0",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0"
    }
  }
}
