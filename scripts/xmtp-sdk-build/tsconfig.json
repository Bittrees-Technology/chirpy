{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] },
    "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
