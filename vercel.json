{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/es/support",
      "destination": "/es/support/index.html"
    },
    {
      "source": "/es/support/",
      "destination": "/es/support/index.html"
    },
    {
      "source": "/es/security",
      "destination": "/es/security/index.html"
    },
    {
      "source": "/es/security/",
      "destination": "/es/security/index.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/security/",
      "destination": "/security.html"
    },
    {
      "source": "/((?!api/|(?:es/)?support/?$|(?:es/)?security/?$|privacy/?$|terms/?$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
