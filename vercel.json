{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/administration",
      "destination": "/api/project-admin"
    },
    {
      "source": "/administration/",
      "destination": "/api/project-admin"
    },
    {
      "source": "/api/project-admin/:path*",
      "destination": "/api/project-admin"
    },
    {
      "source": "/api/shared-roles-health",
      "destination": "/api/project-admin"
    },
    {
      "source": "/mail/optout",
      "destination": "/mail/optout/index.html"
    },
    {
      "source": "/mail/optout/",
      "destination": "/mail/optout/index.html"
    },
    {
      "source": "/es/support",
      "destination": "/es/support/index.html"
    },
    {
      "source": "/es/support/",
      "destination": "/es/support/index.html"
    },
    {
      "source": "/es/security",
      "destination": "/es/security/index.html"
    },
    {
      "source": "/es/security/",
      "destination": "/es/security/index.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/security/",
      "destination": "/security.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/administration/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/mail/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/mail-events.js": {
      "maxDuration": 30
    },
    "api/mail-worker.js": {
      "maxDuration": 60
    },
    "api/mail.js": {
      "maxDuration": 30
    },
    "api/mail/[action].js": {
      "maxDuration": 60
    },
    "api/profile.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/security.html",
      "destination": "/security",
      "permanent": true
    },
    {
      "source": "/support/",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/security/",
      "destination": "/security",
      "permanent": true
    }
  ]
}
