+  /// Explicitly recover one skipped invitation into this existing installation.
+  /// The encrypted envelope must authenticate and match the selected group.
+  #[wasm_bindgen(js_name = recoverMissingWelcome)]
+  pub async fn recover_missing_welcome(
+    &self,
+    envelope: Vec<u8>,
+    #[wasm_bindgen(js_name = expectedGroupId)] expected_group_id: String,
+  ) -> Result<Conversation, JsError> {
+    use prost::Message;
+    if envelope.is_empty() || envelope.len() > 1_048_576 || expected_group_id.is_empty() || expected_group_id.len() > 256 {
+      return Err(JsError::new("Invalid invitation recovery request"));
+    }
+    let group_id = hex::decode(expected_group_id).map_err(ErrorWrapper::js)?;
+    let proto = xmtp_api_d14n::v3::V3ProtoWelcomeMessage::decode(envelope.as_slice()).map_err(|_| JsError::new("Invalid invitation envelope"))?;
+    let welcome = proto.try_into().map_err(|_| JsError::new("Unsupported invitation envelope"))?;
+    let recovered = self.inner_client.recover_missing_welcome(&welcome, group_id)
+      .await.map_err(ErrorWrapper::js)?;
+    recovered.map(Into::into).ok_or_else(|| JsError::new("Invitation did not recover a conversation"))
+  }
