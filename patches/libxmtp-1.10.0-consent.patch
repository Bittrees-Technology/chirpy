+    fn replay_order_preserves_the_latest_consent_for_every_state_sequence() {
+        with_connection(|conn| {
+            let states = [
+                ConsentState::Unknown,
+                ConsentState::Allowed,
+                ConsentState::Denied,
+            ];
+            let orders = [
+                [0, 1, 2],
+                [0, 2, 1],
+                [1, 0, 2],
+                [1, 2, 0],
+                [2, 0, 1],
+                [2, 1, 0],
+            ];
+            let mut case = 0;
+            for first in states {
+                for second in states {
+                    for third in states {
+                        for order in orders {
+                            let entity = format!("replay-order-{case}");
+                            case += 1;
+                            let sequence = [first, second, third];
+                            let mut newest = 0;
+                            for index in order {
+                                newest = newest.max(index);
+                                let record = StoredConsentRecord {
+                                    entity: entity.clone(),
+                                    ..consent_at(sequence[index], (index as i64 + 1) * 10)
+                                };
+                                conn.insert_newer_consent_record(record).unwrap();
+                                let saved = conn
+                                    .get_consent_record(entity.clone(), ConsentType::ConversationId)
+                                    .unwrap()
+                                    .unwrap();
+                                assert_eq!(saved.state, sequence[newest]);
+                                assert_eq!(saved.consented_at_ns, (newest as i64 + 1) * 10);
+                            }
+                        }
+                    }
+                }
+            }
+        })
+    }
