+#[cfg(test)]
+mod welcome_compat_tests {
+    use super::*;
+    fn keys() -> hpke_rs::HpkeKeyPair {
+        WrapperAlgorithm::XWingMLKEM768Draft6.to_hpke_config().derive_key_pair(&[7u8; 32]).unwrap()
+    }
+    fn fixture() -> (Vec<u8>, Vec<u8>) {
+        // Generated independently by hpke-rs 0.4.0 using synthetic seed [7; 32].
+        let ciphertext = HpkeCiphertext {
+            kem_output: hex::decode("").unwrap().into(),
+            ciphertext: hex::decode("a6c9df321ae2229bf2ddf5194458924cee056e05921857c588917b261365ad8e3138fd670434383584").unwrap().into(),
+        };
+        (ciphertext.tls_serialize_detached().unwrap(), hex::decode("e21f2e66621d52fbb1fbfeb2ed71e80a7f2a774c33012329929f15721ec785adf49041bb08fb25ad5584").unwrap())
+    }
+    #[test]
+    fn welcome_compat_release_fixture_and_tampering() {
+        let key = keys();
+        let (body, metadata) = fixture();
+        let algorithm = WrapperAlgorithm::XWingMLKEM768Draft6;
+        let actual = unwrap_welcome(&body, &metadata, key.private_key().as_slice(), algorithm).unwrap();
+        assert_eq!(actual, (b"Synthetic release welcome".to_vec(), b"Synthetic release metadata".to_vec()));
+        let mut bad_body = body.clone();
+        *bad_body.last_mut().unwrap() ^= 1;
+        assert!(unwrap_welcome(&bad_body, &metadata, key.private_key().as_slice(), algorithm).is_err());
+        let mut bad_metadata = metadata.clone();
+        *bad_metadata.last_mut().unwrap() ^= 1;
+        assert!(unwrap_welcome(&body, &bad_metadata, key.private_key().as_slice(), algorithm).is_err());
+        assert!(unwrap_welcome(&body, &metadata, &[0u8; 32], algorithm).is_err());
+    }
+    #[test]
+    fn welcome_compat_reads_earlier_browser_and_sends_release_format() {
+        let key = keys();
+        let algorithm = WrapperAlgorithm::XWingMLKEM768Draft6;
+        let context = openmls::prelude::hpke::EncryptContext::from((WELCOME_HPKE_LABEL, [].as_slice()));
+        let info = context.tls_serialize_detached().unwrap();
+        let mut previous = algorithm.to_hpke_config_with_legacy_code(false);
+        let (enc, mut context) = previous.setup_sender(key.public_key(), &info, None, None, None).unwrap();
+        let body = HpkeCiphertext { kem_output: enc.into(), ciphertext: context.seal(&[], b"Earlier browser welcome").unwrap().into() }.tls_serialize_detached().unwrap();
+        let metadata = context.seal(&[], b"Earlier browser metadata").unwrap();
+        assert_eq!(unwrap_welcome(&body, &metadata, key.private_key().as_slice(), algorithm).unwrap(), (b"Earlier browser welcome".to_vec(), b"Earlier browser metadata".to_vec()));
+        let mut bad = metadata.clone(); *bad.last_mut().unwrap() ^= 1;
+        assert!(unwrap_welcome(&body, &bad, key.private_key().as_slice(), algorithm).is_err());
+        let wrapped = wrap_welcome(b"New welcome", b"New metadata", key.public_key().as_slice(), algorithm).unwrap();
+        let cipher = HpkeCiphertext::tls_deserialize_exact(&wrapped.0).unwrap();
+        let canonical = algorithm.to_hpke_config();
+        let mut receiver = canonical.setup_receiver(cipher.kem_output.as_slice(), key.private_key(), &info, None, None, None).unwrap();
+        assert_eq!(receiver.open(&[], cipher.ciphertext.as_slice()).unwrap(), b"New welcome");
+        assert_eq!(receiver.open(&[], &wrapped.1).unwrap(), b"New metadata");
+        // The reassigned identifier is intentionally not used for outgoing welcomes.
+        let mut previous_receiver = previous.setup_receiver(cipher.kem_output.as_slice(), key.private_key(), &info, None, None, None).unwrap();
+        assert!(previous_receiver.open(&[], cipher.ciphertext.as_slice()).is_err());
+    }
