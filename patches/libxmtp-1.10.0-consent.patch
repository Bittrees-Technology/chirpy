+    #[xmtp_common::test]
+    fn dm_stitch_uses_latest_choice_without_redating_it() {
+        with_connection(|conn| {
+            let mut groups = Vec::new();
+            for id in 1..=3 {
+                let mut group = generate_group(None);
+                group.id = vec![id; 16];
+                group.dm_id = Some("dm:stitch:regression".to_string());
+                group.store(conn).unwrap();
+                groups.push(group);
+            }
+            for (index, state, timestamp) in [
+                (0, ConsentState::Allowed, 10),
+                (1, ConsentState::Denied, 20),
+            ] {
+                conn.insert_or_replace_consent_records(&[StoredConsentRecord {
+                    entity: hex::encode(&groups[index].id),
+                    ..consent_at(state, timestamp)
+                }])
+                .unwrap();
+            }
+            StoredConsentRecord::stitch_dm_consent(conn, &groups[2]).unwrap();
+            let entity = hex::encode(&groups[2].id);
+            let saved = conn
+                .get_consent_record(entity.clone(), ConsentType::ConversationId)
+                .unwrap()
+                .unwrap();
+            assert_eq!(saved.state, ConsentState::Denied);
+            assert_eq!(saved.consented_at_ns, 20);
+            // A later restored unblock must win over the copied decision.
+            assert!(
+                conn.insert_newer_consent_record(StoredConsentRecord {
+                    entity: entity.clone(),
+                    ..consent_at(ConsentState::Allowed, 30)
+                })
+                .unwrap()
+            );
+            StoredConsentRecord::stitch_dm_consent(conn, &groups[2]).unwrap();
+            let saved = conn
+                .get_consent_record(entity, ConsentType::ConversationId)
+                .unwrap()
+                .unwrap();
+            assert_eq!(saved.state, ConsentState::Allowed);
+            assert_eq!(saved.consented_at_ns, 30);
+        })
+    }
