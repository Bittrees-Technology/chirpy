+    fn consent_at(state: ConsentState, timestamp: i64) -> StoredConsentRecord {
+        StoredConsentRecord {
+            entity_type: ConsentType::ConversationId,
+            state,
+            entity: "consent-order-regression".to_string(),
+            consented_at_ns: timestamp,
+        }
+    }
