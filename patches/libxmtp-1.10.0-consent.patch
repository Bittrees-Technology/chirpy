+// Compatibility adapter only: retain HPKE suite code 0x004d while delegating
+// unchanged X-Wing KEM operations to the upstream libcrux provider.
+use hpke_rs_crypto::{HpkeCrypto,error::Error,types::{KemAlgorithm,KdfAlgorithm,AeadAlgorithm}};
+use hpke_rs::libcrux::HpkeLibcrux;
+#[derive(Debug)]
+pub struct WelcomeCompat;
+#[allow(deprecated)]
+fn native_kem(alg: KemAlgorithm) -> KemAlgorithm {
+ match alg { KemAlgorithm::XWingDraft06Obsolete => KemAlgorithm::XWingDraft06, other => other }
+}
+impl HpkeCrypto for WelcomeCompat {
+ type HpkePrng = <HpkeLibcrux as HpkeCrypto>::HpkePrng;
+ fn name() -> String { HpkeLibcrux::name() }
+ fn supports_kdf(alg: KdfAlgorithm) -> Result<(), Error> { HpkeLibcrux::supports_kdf(alg) }
+ fn supports_kem(alg: KemAlgorithm) -> Result<(), Error> { HpkeLibcrux::supports_kem(native_kem(alg)) }
+ fn supports_aead(alg: AeadAlgorithm) -> Result<(), Error> { HpkeLibcrux::supports_aead(alg) }
+ fn prng() -> Self::HpkePrng { HpkeLibcrux::prng() }
+ fn kdf_extract(alg: KdfAlgorithm, salt: &[u8], ikm: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::kdf_extract(alg, salt, ikm) }
+ fn kdf_expand(alg: KdfAlgorithm, prk: &[u8], info: &[u8], output_size: usize) -> Result<Vec<u8>, Error> { HpkeLibcrux::kdf_expand(alg, prk, info, output_size) }
+ fn dh(alg: KemAlgorithm, pk: &[u8], sk: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::dh(native_kem(alg), pk, sk) }
+ fn secret_to_public(alg: KemAlgorithm, sk: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::secret_to_public(native_kem(alg), sk) }
+ fn kem_key_gen(alg: KemAlgorithm, prng: &mut Self::HpkePrng) -> Result<(Vec<u8>, Vec<u8>), Error> { HpkeLibcrux::kem_key_gen(native_kem(alg), prng) }
+ fn kem_key_gen_derand(alg: KemAlgorithm, seed: &[u8]) -> Result<(Vec<u8>, Vec<u8>), Error> { HpkeLibcrux::kem_key_gen_derand(native_kem(alg), seed) }
+ fn kem_encaps(alg: KemAlgorithm, pk_r: &[u8], prng: &mut Self::HpkePrng) -> Result<(Vec<u8>, Vec<u8>), Error> { HpkeLibcrux::kem_encaps(native_kem(alg), pk_r, prng) }
+ fn kem_decaps(alg: KemAlgorithm, ct: &[u8], sk_r: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::kem_decaps(native_kem(alg), ct, sk_r) }
+ fn dh_validate_sk(alg: KemAlgorithm, sk: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::dh_validate_sk(native_kem(alg), sk) }
+ fn aead_seal(alg: AeadAlgorithm, key: &[u8], nonce: &[u8], aad: &[u8], msg: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::aead_seal(alg, key, nonce, aad, msg) }
+ fn aead_open(alg: AeadAlgorithm, key: &[u8], nonce: &[u8], aad: &[u8], msg: &[u8]) -> Result<Vec<u8>, Error> { HpkeLibcrux::aead_open(alg, key, nonce, aad, msg) }
+}
