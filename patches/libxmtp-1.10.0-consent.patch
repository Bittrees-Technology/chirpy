+    #[xmtp_common::test]
+    fn creator_default_never_overrides_an_explicit_choice_in_either_order() {
+        with_connection(|conn| {
+            for state in [
+                ConsentState::Unknown,
+                ConsentState::Allowed,
+                ConsentState::Denied,
+            ] {
+                for timestamp in [0, 1, 1_700_000_000_000_000_000] {
+                    for default_first in [false, true] {
+                        let entity = format!("creator-{state:?}-{timestamp}-{default_first}");
+                        let default = StoredConsentRecord::creator_default(entity.clone());
+                        let explicit = StoredConsentRecord {
+                            entity: entity.clone(),
+                            ..consent_at(state, timestamp)
+                        };
+                        let sequence = if default_first {
+                            [default, explicit]
+                        } else {
+                            [explicit, default]
+                        };
+                        for record in sequence {
+                            conn.insert_newer_consent_record(record).unwrap();
+                        }
+                        let saved = conn
+                            .get_consent_record(entity, ConsentType::ConversationId)
+                            .unwrap()
+                            .unwrap();
+                        assert_eq!(saved.state, state);
+                        assert_eq!(saved.consented_at_ns, timestamp);
+                    }
+                }
+            }
+        })
+    }
