+    #[xmtp_common::test]
+    fn local_consent_timestamp_prevents_older_replay() {
+        with_connection(|conn| {
+            for (timestamp, state) in [
+                (1, ConsentState::Allowed),
+                (3, ConsentState::Denied),
+                (5, ConsentState::Allowed),
+            ] {
+                conn.insert_or_replace_consent_records(&[consent_at(state, timestamp)])
+                    .unwrap();
+                let saved = conn
+                    .get_consent_record(
+                        "consent-order-regression".into(),
+                        ConsentType::ConversationId,
+                    )
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(saved.consented_at_ns, timestamp);
+                assert_eq!(saved.state, state);
+            }
+            assert!(
+                !conn
+                    .insert_newer_consent_record(consent_at(ConsentState::Denied, 3))
+                    .unwrap()
+            );
+            let saved = conn
+                .get_consent_record(
+                    "consent-order-regression".into(),
+                    ConsentType::ConversationId,
+                )
+                .unwrap()
+                .unwrap();
+            assert_eq!(saved.state, ConsentState::Allowed);
+            assert_eq!(saved.consented_at_ns, 5);
+            assert!(
+                conn.insert_newer_consent_record(consent_at(ConsentState::Denied, 6))
+                    .unwrap()
+            );
+        })
+    }
