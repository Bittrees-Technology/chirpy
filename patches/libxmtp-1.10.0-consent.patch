+            let mut case = 0;
+            for first in states {
+                for second in states {
+                    for third in states {
+                        for order in orders {
+                            let entity = format!("replay-order-{case}");
+                            case += 1;
+                            let sequence = [first, second, third];
+                            let mut newest = 0;
+                            for index in order {
